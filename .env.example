# Toss OpenAPI credentials (never commit the real secret)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=

# paper | live
TRADING_MODE=paper
# Live mode remains locked unless this exact value is set.
LIVE_TRADING_CONFIRM=

# Scheduler (KST)
SCAN_INTERVAL_SECONDS=30
ENTRY_WINDOWS=10:00-11:30,14:50-15:10
FORCE_EXIT_TIME=15:25
PROCESS_STOP_TIME=15:40
ORDER_TIMEOUT_SECONDS=12
MAX_CONSECUTIVE_ERRORS=3
MAX_DATA_AGE_SECONDS=180

# Conservative risk defaults
PAPER_STARTING_CASH_KRW=1000000
MAX_TRADE_KRW=100000
MAX_OPEN_POSITIONS=2
MAX_DAILY_ENTRIES=2
CANDLE_LOOKBACK_COUNT=200
ADAPTIVE_SHADOW_ENABLED=true
ADAPTIVE_SHADOW_MAX_CANDIDATES=10
ADAPTIVE_SHADOW_MIN_SCORE=0.65
BREAKOUT_CONFIRMATION_CANDLES=2
PAPER_CONTINUATION_ENTRY_ENABLED=true
CONTINUATION_CONFIRMATION_EVALUATIONS=2
CONTINUATION_BREAKOUT_MAX_AGE_MINUTES=10
CONTINUATION_MIN_ENTRY_SCORE=0.85
CONTINUATION_MIN_VOLUME_SCORE=0.80
CONTINUATION_MIN_TRADE_PRESSURE_SCORE=0.55
CONTINUATION_MIN_ORDERBOOK_SCORE=0.50
CONTINUATION_MAX_VWAP_DISTANCE=0.05
CONTINUATION_MAX_BREAKOUT_DISTANCE=0.015
FAILURE_EXIT_ENABLED=true
FAILURE_EXIT_CONFIRMATION_CANDLES=2
FAILURE_EXIT_MAX_TRADE_PRESSURE=0.45
MAX_DAILY_LOSS_RATE=0.010
MAX_DAILY_LOSS_KRW=0
MAX_DAILY_PROFIT_LOCK_RATE=0.020
RISK_PER_TRADE_RATE=0.0035
MAX_POSITION_RATE=0.10
STOP_LOSS_RATE=0.008
TAKE_PROFIT_RATE=0.015
TRAILING_STOP_RATE=0.006
MIN_HOLD_SECONDS=180
MIN_VOLATILITY_RATE=0.004
MAX_STOP_LOSS_RATE=0.020
ATR_STOP_MULTIPLIER=1.5
ATR_TAKE_PROFIT_MULTIPLIER=2.5
ATR_TRAILING_MULTIPLIER=1.25

# Momentum filters
RANKING_COUNT=30
MIN_TRADING_AMOUNT_KRW=50000000000
MIN_DAILY_CHANGE_RATE=0.020
MAX_DAILY_CHANGE_RATE=0.120
MIN_5M_MOMENTUM_RATE=0.008
MAX_5M_MOMENTUM_RATE=0.040
MIN_15M_MOMENTUM_RATE=0.012
MAX_15M_MOMENTUM_RATE=0.080
MIN_VOLUME_SURGE=1.50
MAX_SPREAD_RATE=0.004
MAX_PRICE_OVER_VWAP_RATE=0.050
MAX_ENTRY_SLIPPAGE_RATE=0.003
INSTITUTIONAL_PROXY_FILTER=true
MIN_ORDERBOOK_IMBALANCE_RATE=0.10
MIN_INSTITUTIONAL_PROXY_SCORE=3

# Block entries only when both KOSPI and KOSDAQ are in a sharp downswing.
MARKET_REGIME_FILTER=true
MIN_MARKET_5M_RATE=-0.005
MIN_MARKET_15M_RATE=-0.010
